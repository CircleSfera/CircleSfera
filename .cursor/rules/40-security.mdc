description: Auth, authorization, CSRF and data-exposure rules for CircleSfera security-sensitive code
globs: circlesfera-backend/src/auth/**, circlesfera-backend/src/admin/**, circlesfera-backend/src/main.ts, circlesfera-backend/src/common/config/**, circlesfera-backend/src/common/services/crypto.service.ts
alwaysApply: false
