# Root / shared example env for local tooling and production reference.
# Copy to .env (and .env.production for OVH) and fill real values. Never commit secrets.

# --- Playwright e2e ---
E2E_USER_EMAIL=e2e@example.com
E2E_USER_PASSWORD=change-me-strong-password
E2E_USER_USERNAME=e2euser
E2E_USER_FULL_NAME=E2E Test User
BASE_URL=http://localhost:5173
# Prefer PLAYWRIGHT_BASE_URL if BASE_URL is reused for the API in your shell/.env
# PLAYWRIGHT_BASE_URL=http://localhost:5173
# Admin Panel host suite (hostname must start with admin.)
ADMIN_BASE_URL=http://admin.localhost:5173
ADMIN_E2E_EMAIL=admin@circlesfera.com
ADMIN_E2E_PASSWORD=password123
# Optional CI only (ADMIN_E2E_FORCE_TOTP=1). Never set FORCE for human local Authenticator use.
# ADMIN_E2E_FORCE_TOTP=1
ADMIN_E2E_TOTP_SECRET=GK3L6YHMZSMTIZMLWAX3DJBYBOENFNJV
BACKEND_URL=http://localhost:3005/api/v1

# --- Core runtime ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/circlesfera?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=circlesfera
FRONTEND_URL=http://localhost:5173
# Include Admin Panel origin when using admin.localhost / admin.circlesfera.com
CORS_ORIGIN=http://localhost:5173,http://admin.localhost:5173

# --- Auth / security (REQUIRED; no insecure defaults) ---
JWT_SECRET=change-me-jwt-secret-at-least-64-characters-long-for-production!!!!
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-64-characters-long-prod!!!!
# Admin Panel admin JWT. Prefer a distinct secret from JWT_SECRET.
JWT_ADMIN_SECRET=change-me-admin-jwt-secret-at-least-64-characters-long-prod!!
CSRF_SECRET=change-me-csrf-secret-at-least-64-characters-long-for-prod!!!!
# Chat message encryption (REQUIRED, min 32 chars). Never reuse the legacy default.
ENCRYPTION_KEY=change-me-encryption-key-32chars-min!!
# HMAC pepper for IP / UA / device visitor hashes (REQUIRED in production, min 32 chars).
ABUSE_HASH_PEPPER=change-me-abuse-hash-pepper-32chars-min!!
# Cloudflare Turnstile (register + login). Dummy always-pass keys are fine in local/e2e:
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Optional GeoLite2 country lookup at signup (ISO-3166-1 alpha-2). CF-IPCountry is used first.
# GEOIP_DB_PATH=
# Only for reencrypt-messages.ts migration from the historical fallback:
# ENCRYPTION_KEY_LEGACY=default-secret-key-32-chars-long!

# --- Redis ---
REDIS_PASSWORD=change-me-strong-redis-password
# REDIS_HOST=localhost
# REDIS_PORT=6379

# --- Payments ---
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# --- Live streaming (LiveKit). Required in production. ---
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=wss://your-project.livekit.cloud
# VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# --- AI (moderation, embeddings, alt-text, Studio Whisper captions) ---
# OPENAI_API_KEY=sk-...

# --- Email (Brevo) ---
# BREVO_API_KEY=
# EMAIL_FROM=noreply@circlesfera.com
# EMAIL_FROM_NAME=CircleSfera

# --- Push (Web Push / VAPID) ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@circlesfera.com

# --- Passkeys ---
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:5173

# --- Observability (set real DSNs in .env and .env.production) ---
SENTRY_DSN=
VITE_SENTRY_DSN=

# --- Slack ops ---
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# SLACK_WEBHOOK_ALERTS=
# SLACK_WEBHOOK_MODERATION=
# SLACK_WEBHOOK_PAYMENTS=
# SLACK_WEBHOOK_DEPLOYMENTS=
# SLACK_WEBHOOK_SUPPORT=

# --- Optional media providers (default = local disk uploads/) ---
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# CDN_URL=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Frontend bake-time ---
# VITE_API_URL=http://localhost:3000/api/v1
# VITE_API_PROXY_TARGET=http://backend:3000
# Local Admin Panel on localhost (alternative to admin.localhost):
# VITE_ADMIN_PANEL=true
# Or pin the Admin Panel hostname:
# VITE_ADMIN_PANEL_HOST=admin.circlesfera.com

# --- Backups (scripts/backup-*.sh) ---
# BACKUP_DIR=./backups
# RETENTION_DAYS=30
# S3_BACKUP_BUCKET=
# UPLOADS_DIR=./circlesfera-backend/uploads

# GitHub E2E secrets setup (after `gh auth login`):
#   ./scripts/setup-github-e2e.sh
# Prod env upload:
#   ./scripts/upload-prod-env.sh
