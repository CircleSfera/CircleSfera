# LF everywhere, whatever core.autocrlf says: Biome (lineEnding: lf) and the
# shell scripts expect LF, also in a Windows checkout.
* text=auto eol=lf

# Windows batch files keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.mp4 binary
*.m4a binary
*.jar binary
