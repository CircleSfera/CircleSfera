{
  "name": "circlesfera-backend",
  "version": "1.0.0",
  "description": "CircleSfera Backend API - Social Media Platform",
  "author": "CircleSfera Team",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "format": "biome format --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node scripts/build.mjs && node dist/main.js",
    "dev": "node --watch-path=src --watch-preserve-output scripts/dev.mjs",
    "start:dev": "node --watch-path=src --watch-preserve-output scripts/dev.mjs",
    "start:debug": "node --inspect --watch-path=src --watch-preserve-output scripts/dev.mjs",
    "start:prod": "node dist/main.js",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "check:deps": "node ../scripts/check-module-boundaries.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.e2e.config.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "npx tsx prisma/seed.ts",
    "prisma:seed:audio": "npx tsx prisma/seed-audio.ts",
    "bootstrap-admin": "ts-node scripts/bootstrap-admin.ts",
    "prisma:studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "prisma:check-migrations": "DATABASE_URL=\"${DATABASE_URL:?Set DATABASE_URL to an empty Postgres}\" ../scripts/check-prisma-schema-migrations.sh",
    "check-user": "ts-node scripts/check-user.ts",
    "e2e:cleanup": "tsx scripts/cleanup-e2e-users.ts",
    "embeddings:backfill": "tsx scripts/generate-embeddings.ts",
    "create-smoke-test-user": "tsx scripts/create-smoke-test-user.ts",
    "media:backfill": "tsx src/scripts/backfill-media-entity.ts"
  },
  "overrides": {
    "fast-uri": "4.2.3",
    "engine.io": "6.6.11",
    "socket.io-parser": "4.2.7",
    "qs": "6.17.1",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.6",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "multer": "2.5.0",
    "socket.io": "$socket.io",
    "@nestjs/swagger": {
      "typescript": "$typescript"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/lib-storage": "3.1161.0",
    "@circlesfera/shared": "file:../circlesfera-shared",
    "@getbrevo/brevo": "6.2.0",
    "@keyv/redis": "6.1.0",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/cache-manager": "12.0.2",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/platform-socket.io": "12.3.2",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/serve-static": "12.1.1",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "12.3.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/config": "7.10.1",
    "@sentry/nestjs": "11.10.0",
    "@sentry/profiling-node": "11.10.0",
    "@simplewebauthn/server": "14.0.3",
    "@socket.io/redis-adapter": "8.3.0",
    "@types/web-push": "3.6.4",
    "archiver": "8.0.0",
    "argon2": "0.45.1",
    "axios": "1.21.0",
    "bcrypt": "6.0.0",
    "buffer-to-stream": "1.0.0",
    "bullmq": "6.5.2",
    "cache-manager": "7.2.9",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cloudinary": "2.11.0",
    "cookie": "2.0.1",
    "cookie-parser": "1.4.7",
    "csrf-csrf": "4.0.3",
    "date-fns": "4.4.0",
    "dotenv": "18.0.9",
    "file-type": "22.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "keyv": "6.1.0",
    "livekit-server-sdk": "2.19.2",
    "nestjs-pino": "5.3.1",
    "openai": "7.46.0",
    "otplib": "13.5.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "stripe": "23.1.0",
    "swagger-ui-express": "5.0.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@nestjs/testing": "12.3.2",
    "@swc/core": "1.16.20",
    "@types/archiver": "8.0.0",
    "@types/bcrypt": "6.0.0",
    "@types/buffer-to-stream": "1.0.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "globals": "17.13.0",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "7.0.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "@scarf/scarf": false,
    "@sentry/node-cpu-profiler": true,
    "@swc/core": true,
    "argon2": true,
    "bcrypt": true,
    "fsevents": true,
    "msgpackr-extract": true,
    "prisma": true
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
