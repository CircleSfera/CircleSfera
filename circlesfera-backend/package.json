{
  "name": "circlesfera-backend",
  "version": "1.0.0",
  "description": "CircleSfera Backend API - Social Media Platform",
  "author": "CircleSfera Team",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "nest build && node scripts/inject-require.js",
    "format": "biome format --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start --exec \"node dist/main.js\"",
    "dev": "nest start --watch --exec \"node scripts/inject-require.js && node dist/main.js\"",
    "start:dev": "nest start --watch --exec \"node scripts/inject-require.js && node dist/main.js\"",
    "start:debug": "nest start --debug --watch --exec \"node --inspect dist/main.js\"",
    "start:prod": "node dist/main.js",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "check:deps": "depcruise src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.e2e.config.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "npx tsx prisma/seed.ts",
    "prisma:seed:audio": "npx tsx prisma/seed-audio.ts",
    "bootstrap-admin": "ts-node scripts/bootstrap-admin.ts",
    "prisma:studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "prisma:check-migrations": "DATABASE_URL=\"${DATABASE_URL:?Set DATABASE_URL to an empty Postgres}\" ../scripts/check-prisma-schema-migrations.sh",
    "check-user": "ts-node scripts/check-user.ts",
    "e2e:cleanup": "tsx scripts/cleanup-e2e-users.ts",
    "embeddings:backfill": "tsx scripts/generate-embeddings.ts"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "@hono/node-server": "1.19.17",
    "fast-uri": "4.1.4",
    "socket.io-parser": "4.2.7",
    "qs": "6.16.0",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.3",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@5": "5.0.9"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
