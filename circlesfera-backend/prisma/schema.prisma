// CircleSfera Prisma schema — canonical data model.
// Docs: https://pris.ly/d/prisma-schema
// Domain sections below; enums live at the end. Reorder of models/enums is cosmetic (no migration).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// =============================================================================
// === Auth / Account
// =============================================================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Account status
  isActive            Boolean   @default(true)
  isRootBanned        Boolean   @default(false)
  rootBanReason       String?   @db.Text
  strikeCount         Int       @default(0)
  deletedAt           DateTime? // Soft-delete / deactivation timestamp
  scheduledDeletionAt DateTime? // Hard-delete due date (grace window); null = not scheduled

  isOnline   Boolean   @default(false)
  lastSeenAt DateTime?

  role              Role              @default(USER)
  verificationLevel VerificationLevel @default(BASIC)
  accountType       AccountType       @default(PERSONAL)

  // Identity & KYC
  identityVerifiedAt      DateTime?
  dateOfBirth             DateTime?
  stripeIdentitySessionId String?   @unique
  emailVerified           DateTime?
  verificationToken       String?   @unique

  // Auth secrets
  isTwoFactorEnabled Boolean   @default(false)
  twoFactorSecret    String?
  resetToken         String?   @unique
  resetTokenExpires  DateTime?
  currentChallenge   String? // WebAuthn registration/auth challenge (temporary)

  // Abuse / trust — raw IP for account lifetime; hashes for clustering. Public APIs never expose raw IP.
  signupIp       String?
  lastIp         String?
  signupIpHash   String?
  lastIpHash     String?
  signupCountry  String?
  botLabeledAt   DateTime?
  botLabelReason String?

  // Growth & referrals
  inviteCode   String? @unique
  referredById String?
  referredBy   User?   @relation("UserReferrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("UserReferrals")

  // Stripe Connect / platform billing
  stripeCustomerId       String?                @unique
  stripeConnectAccountId String?                @unique

  // Relations (account-scoped; social content lives on Profile)
  profiles              Profile[]
  refreshTokens         RefreshToken[]
  passkeys              Passkey[]
  deviceSignals         DeviceSignal[]
  settings              UserSettings?
  linkedAdminIdentities AdminIdentity[] // Correlation only, never auth
  dataExportRequests    DataExportRequest[]
  pushSubscriptions     PushSubscription[]
  promotions            Promotion[]
  platformSubscriptions PlatformSubscription[]
  interactionEvents     InteractionEvent[]
  monetization          Monetization?
  sentTransactions      Transaction[]          @relation("SentTransactions")
  receivedTransactions  Transaction[]          @relation("ReceivedTransactions")
  postUnlocks           PostUnlock[]
  storyUnlocks          StoryUnlock[]
  messageUnlocks        MessageUnlock[]
  sentLiveGifts         LiveGift[]             @relation("LiveGiftSender")
  receivedLiveGifts     LiveGift[]             @relation("LiveGiftReceiver")
  supportTickets        SupportTicket[]
  appeals               Appeal[]
  userExperiments       UserExperiment[]
  stripePayoutLogs      StripePayoutLog[]

  @@index([isOnline])
  @@index([scheduledDeletionAt])
  @@index([signupIp])
  @@index([lastIp])
  @@index([signupIpHash])
  @@index([lastIpHash])
  @@index([botLabeledAt])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Passkey {
  id           String   @id @default(uuid())
  userId       String
  credentialID String   @unique
  publicKey    Bytes
  counter      BigInt
  transports   String[] @default([])
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

/// First-party device hash for T&S clustering. visitorHash is HMAC(visitorId).
model DeviceSignal {
  id            String   @id @default(uuid())
  userId        String
  visitorHash   String
  userAgentHash String?
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, visitorHash])
  @@index([visitorHash])
  @@map("device_signals")
}

model UserSettings {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  privacyLevel         Visibility    @default(PUBLIC)
  contentPreference    ContentRating @default(GENERAL)
  blurSensitiveContent Boolean       @default(true)
  emailNotifications   Boolean       @default(true)
  pushNotifications    Boolean       @default(true)
  isOnboarded          Boolean       @default(false)

  updatedAt DateTime @updatedAt

  @@map("user_settings")
}

model DataExportRequest {
  id        String       @id @default(uuid())
  userId    String
  status    ExportStatus @default(PENDING)
  expiresAt DateTime?
  url       String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("data_export_requests")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// =============================================================================
// === Profile / Social
// =============================================================================

model Profile {
  id                String  @id @default(uuid())
  userId            String
  username          String  @unique
  fullName          String?
  bio               String?
  avatar            String?
  standardUrl       String? // New: Optimized variant
  thumbnailUrl      String? // New: Optimized variant
  cover             String?
  coverStandardUrl  String?
  coverThumbnailUrl String?
  website           String?
  location          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Account Ban Flags

  isAccountBanned  Boolean   @default(false)
  accountBanReason String?   @db.Text
  suspendedUntil   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Social Relations Moved from User

  posts               Post[]
  stories             Story[]
  liveStreams         LiveStream[]       @relation("LiveStreamHost")
  coHostedStreams     LiveStream[]       @relation("LiveStreamCoHost")
  comments            Comment[]
  likes               Like[]
  commentLikes        CommentLike[]
  followers           Follow[]           @relation("UserFollowing")
  following           Follow[]           @relation("UserFollowers")
  notifications       Notification[]     @relation("NotificationRecipient")
  sentNotifications   Notification[]     @relation("NotificationSender")
  participants        Participant[]
  messages            Message[]
  messageReactions    MessageReaction[] // New: User reactions to messages
  blockedBy           Block[]            @relation("BlockedBy")
  blocking            Block[]            @relation("Blocking")
  mutedBy             Mute[]             @relation("MutedBy")
  muting              Mute[]             @relation("Muting")
  bookmarks           Bookmark[]
  collections         Collection[]
  highlights          Highlight[]
  closeFriends        CloseFriend[] @relation("CloseFriendOwner")
  closeFriendOf       CloseFriend[] @relation("CloseFriendTarget")
  storyViews          StoryView[]
  storyReactions      StoryReaction[]
  taggedPosts         PostTag[]
  reports             Report[]           @relation("ReportReporter")
  searchHistory       SearchHistory[]
  postViews           PostView[]
  feedHiddenPosts     FeedHiddenPost[]
  feedHiddenAuthors   FeedHiddenAuthor[] @relation("FeedHidingAuthor")
  feedHiddenByAuthors FeedHiddenAuthor[] @relation("FeedHiddenAsAuthor")
  feedMutedKeywords   FeedMutedKeyword[]
  editProjects        EditProject[]
  pollVotes           PollVote[]
  qnaAnswers          QnaAnswer[]
  metrics             ProfileMetric[]
  embedding           ProfileEmbedding?

  @@index([userId])
  @@map("profiles")
}

model Post {
  id        String   @id @default(uuid())
  profileId String
  caption   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile       Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  media         PostMedia[] // New: Support for multiple media files
  comments      Comment[]
  likes         Like[]
  bookmarks     Bookmark[]
  hashtags      PostHashtag[]
  notifications Notification[]
  embedding     PostEmbedding? // New: AI Embedding support
  postViews     PostView[] // New: Analytics support

  // New: Sharing in Chat

  sharedInMessages Message[] @relation("SharedPosts")

  tags PostTag[] // New: Tagged users

  location        String?
  hideLikes       Boolean @default(false)
  turnOffComments Boolean @default(false)

  type             PostType      @default(POST)
  contentRating    ContentRating @default(GENERAL)
  views            Int           @default(0)
  loops            Int           @default(0) // For Frames (vertical video)
  watchTime        Int           @default(0) // Total watch time in seconds
  performanceScore Float         @default(0)
  visibility       Visibility    @default(PUBLIC)
  audioId          String?
  audio            Audio?        @relation(fields: [audioId], references: [id], onDelete: SetNull)

  moderationStatus ModerationStatus @default(VISIBLE)
  moderationNote   String?          @db.Text

  // Premium Content

  isPremium   Boolean      @default(false)
  priceCents  Int          @default(0) // Price in fiat cents (e.g., 500 = $5.00)
  postUnlocks PostUnlock[]

  // Scheduling & Interactive Features
  scheduledAt     DateTime?
  scheduledStatus ScheduledPostStatus @default(PUBLISHED)
  poll            Poll?
  qnaBox          QnaBox?

  // Feed preferences

  hiddenByUsers FeedHiddenPost[]

  @@index([profileId, type, visibility, createdAt, moderationStatus])
  @@index([type])
  @@index([createdAt])
  @@index([visibility])
  @@index([contentRating])
  @@index([moderationStatus, visibility, createdAt(sort: Desc)])
  @@index([scheduledStatus, scheduledAt])
  @@map("posts")
}

model PostMedia {
  id           String   @id @default(uuid())
  postId       String
  url          String
  standardUrl  String? // New: Optimized variant
  thumbnailUrl String? // New: Optimized variant
  type         String   @default("image") // "image" | "video"
  order        Int      @default(0) // For carousel ordering
  filter       String? // Store filter ID (e.g. "sepia", "clarendon")
  altText      String? // Accessibility text
  createdAt    DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_media")
}

model PostTag {
  postId    String
  profileId String
  x         Float? // Optional: X coordinate (0-1)
  y         Float? // Optional: Y coordinate (0-1)
  createdAt DateTime @default(now())

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([postId, profileId])
  @@index([profileId])
  @@map("post_tags")
}

model PostHashtag {
  postId    String
  hashtagId String
  createdAt DateTime @default(now())

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId])
  @@index([hashtagId])
  @@map("post_hashtags")
}

model Hashtag {
  id        String   @id @default(uuid())
  tag       String   @unique
  postCount Int      @default(0)
  createdAt DateTime @default(now())

  posts PostHashtag[]

  @@index([postCount(sort: Desc)])
  @@map("hashtags")
}

model Audio {
  id           String   @id @default(uuid())
  title        String
  artist       String
  url          String
  thumbnailUrl String?
  duration     Int // in seconds
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts   Post[]
  stories Story[]

  @@map("audio_tracks")
}

model Story {
  id           String   @id @default(uuid())
  profileId    String
  url          String
  standardUrl  String? // New: Optimized variant
  thumbnailUrl String? // New: Optimized variant
  mediaType    String   @default("image") // image or video
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  // Close Friends support

  isCloseFriendsOnly Boolean @default(false)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  audioId String?
  audio   Audio?  @relation(fields: [audioId], references: [id], onDelete: SetNull)

  moderationStatus ModerationStatus @default(VISIBLE)
  moderationNote   String?

  // Relation to highlights

  highlightStories HighlightStory[]

  // Views

  views StoryView[]

  // New: Story Reactions

  reactions StoryReaction[]

  // New: Sharing in Chat/DM

  sharedInMessages Message[] @relation("SharedStories")

  notifications Notification[]

  // Premium Content

  isPremium    Boolean       @default(false)
  priceCents   Int           @default(0)
  storyUnlocks StoryUnlock[]

  // Scheduling & Interactive Features

  scheduledAt     DateTime?
  scheduledStatus ScheduledPostStatus @default(PUBLISHED)
  poll            Poll?
  qnaBox          QnaBox?

  @@index([profileId, expiresAt])
  @@index([profileId, createdAt])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("stories")
}

model StoryView {
  id        String   @id @default(uuid())
  storyId   String
  viewerId  String
  createdAt DateTime @default(now())

  story  Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer Profile @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId]) // One view per profile per story
  @@index([storyId])
  @@map("story_views")
}

model StoryReaction {
  id        String   @id @default(uuid())
  storyId   String
  profileId String
  reaction  String // e.g. "❤️", "🔥", "😂"
  createdAt DateTime @default(now())

  story   Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([storyId, profileId])
  @@index([storyId])
  @@map("story_reactions")
}

model Highlight {
  id        String   @id @default(uuid())
  profileId String
  title     String
  coverUrl  String? // Optional custom cover, otherwise use first story
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  stories HighlightStory[]

  @@index([profileId])
  @@map("highlights")
}

model HighlightStory {
  id          String   @id @default(uuid())
  highlightId String
  storyId     String
  createdAt   DateTime @default(now())

  highlight Highlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  story     Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([highlightId, storyId])
  @@map("highlight_stories")
}

model Comment {
  id           String   @id @default(uuid())
  postId       String
  profileId    String
  content      String
  url          String?
  standardUrl  String? // New: Optimized variant (HLS)
  thumbnailUrl String? // New: Optimized variant
  mediaType    String? // "image", "video", "file"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  moderationStatus ModerationStatus @default(VISIBLE)
  moderationNote   String?

  // Voice Notes Support

  voiceUrl      String?
  voiceDuration Int?
  voiceWaveform Json?

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Self-relation for nested comments

  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  // Likes

  likes CommentLike[]

  @@index([postId, createdAt])
  @@index([profileId])
  @@index([parentId])
  @@index([createdAt])
  @@map("comments")
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  profileId String
  createdAt DateTime @default(now())

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([postId, profileId])
  @@index([profileId, createdAt])
  @@index([postId])
  @@map("likes")
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String
  profileId String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([commentId, profileId])
  @@index([commentId])
  @@index([profileId])
  @@map("comment_likes")
}

model Follow {
  id          String       @id @default(uuid())
  followerId  String
  followingId String
  status      FollowStatus @default(ACCEPTED)
  createdAt   DateTime     @default(now())

  follower  Profile @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following Profile @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId, status])
  @@index([followingId, status])
  @@map("follows")
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker Profile @relation("Blocking", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Profile @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model Mute {
  id        String   @id @default(uuid())
  muterId   String
  mutedId   String
  createdAt DateTime @default(now())

  muter Profile @relation("Muting", fields: [muterId], references: [id], onDelete: Cascade)
  muted Profile @relation("MutedBy", fields: [mutedId], references: [id], onDelete: Cascade)

  @@unique([muterId, mutedId])
  @@index([mutedId])
  @@map("mutes")
}

model CloseFriend {
  id        String   @id @default(uuid())
  profileId String
  friendId  String
  createdAt DateTime @default(now())

  profile Profile @relation("CloseFriendOwner", fields: [profileId], references: [id], onDelete: Cascade)
  friend  Profile @relation("CloseFriendTarget", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([profileId, friendId])
  @@index([profileId])
  @@index([friendId])
  @@map("close_friends")
}

model Bookmark {
  id        String   @id @default(uuid())
  profileId String
  postId    String
  createdAt DateTime @default(now())

  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([profileId, postId])
  @@index([profileId, createdAt])
  @@index([postId])
  @@index([collectionId])
  @@map("bookmarks")
}

model Collection {
  id           String   @id @default(uuid())
  profileId    String
  name         String
  coverUrl     String?
  standardUrl  String? // New: Optimized variant
  thumbnailUrl String? // New: Optimized variant
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  bookmarks Bookmark[]

  @@index([profileId])
  @@map("collections")
}

model SearchHistory {
  id        String    @id @default(uuid())
  profileId String
  query     String
  createdAt DateTime  @default(now())
  expiresAt DateTime? // INC-08: GDPR retention (90 days)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([expiresAt])
  @@map("search_history")
}

model EditProject {
  id        String   @id @default(uuid())
  profileId String
  name      String?
  mediaUrl  String
  mediaType String   @default("image")
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, updatedAt])
  @@map("edit_projects")
}

// =============================================================================
// === Live
// =============================================================================

model LiveStream {
  id          String     @id @default(uuid())
  hostId      String
  coHostId    String?
  title       String?
  status      LiveStatus @default(LIVE)
  viewerCount Int        @default(0)
  startedAt   DateTime   @default(now())
  endedAt     DateTime?
  hlsUrl      String?
  replayUrl   String?

  host         Profile       @relation("LiveStreamHost", fields: [hostId], references: [id])
  coHost       Profile?      @relation("LiveStreamCoHost", fields: [coHostId], references: [id])
  gifts        LiveGift[]
  transactions Transaction[]

  @@index([status])
  @@index([hostId])
  @@index([coHostId])
  @@map("live_streams")
}

/// Paid virtual gift sent during a live stream (Stripe Checkout + webhook).
model LiveGift {
  id                      String            @id @default(uuid())
  streamId                String
  senderId                String
  receiverId              String
  giftId                  String // catalog key: star | flame | crown | gem | rocket
  amountCents             Int
  currency                String            @default("EUR")
  status                  TransactionStatus @default(PENDING)
  stripeCheckoutSessionId String?           @unique
  transactionId           String?           @unique
  createdAt               DateTime          @default(now())
  completedAt             DateTime?

  stream      LiveStream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  sender      User         @relation("LiveGiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User         @relation("LiveGiftReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([streamId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@map("live_gifts")
}

// =============================================================================
// === Interactive
// =============================================================================

model Poll {
  id        String   @id @default(uuid())
  postId    String?  @unique
  storyId   String?  @unique
  question  String
  options   String[]
  createdAt DateTime @default(now())

  post  Post?  @relation(fields: [postId], references: [id], onDelete: Cascade)
  story Story? @relation(fields: [storyId], references: [id], onDelete: Cascade)

  votes PollVote[]

  @@map("polls")
}

model PollVote {
  id          String   @id @default(uuid())
  pollId      String
  profileId   String
  optionIndex Int
  createdAt   DateTime @default(now())

  poll    Poll    @relation(fields: [pollId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([pollId, profileId])
  @@index([pollId])
  @@map("poll_votes")
}

model QnaBox {
  id        String   @id @default(uuid())
  postId    String?  @unique
  storyId   String?  @unique
  prompt    String
  createdAt DateTime @default(now())

  post  Post?  @relation(fields: [postId], references: [id], onDelete: Cascade)
  story Story? @relation(fields: [storyId], references: [id], onDelete: Cascade)

  answers QnaAnswer[]

  @@map("qna_boxes")
}

model QnaAnswer {
  id         String   @id @default(uuid())
  qnaBoxId   String
  profileId  String
  answerText String   @db.Text
  createdAt  DateTime @default(now())

  qnaBox  QnaBox  @relation(fields: [qnaBoxId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([qnaBoxId])
  @@map("qna_answers")
}

// =============================================================================
// === Chat
// =============================================================================

model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name      String?
  avatarUrl String?
  isGroup   Boolean @default(false)

  messages     Message[]
  participants Participant[]

  @@index([updatedAt])
  @@map("conversations")
}

model Participant {
  id             String    @id @default(uuid())
  conversationId String
  profileId      String
  isAdmin        Boolean   @default(false)
  lastReadAt     DateTime  @default(now()) // For "Seen" status
  createdAt      DateTime  @default(now())
  deletedAt      DateTime? // Allows "Delete for me" functionality
  clearedAt      DateTime? // Hides messages before this time

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([conversationId, profileId])
  @@map("participants")
}

model Message {
  id             String  @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  url            String?
  standardUrl    String? // New: Optimized variant (HLS)
  thumbnailUrl   String? // New: Optimized variant
  mediaType      String? // New: "image", "video", "file"

  // Voice Notes Support

  voiceUrl      String?
  voiceDuration Int?
  voiceWaveform Json?

  // GDPR: Retention

  expiresAt DateTime?

  // Premium Content (PPV)

  isLocked       Boolean         @default(false)
  priceCents     Int             @default(0)
  messageUnlocks MessageUnlock[]

  // New: Post Sharing

  postId String?
  post   Post?   @relation("SharedPosts", fields: [postId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  isEdited  Boolean @default(false)
  isDeleted Boolean @default(false)

  // New: Reply support

  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies   Message[] @relation("MessageReplies")

  // New: Story Sharing/Replying

  storyId String?
  story   Story?  @relation("SharedStories", fields: [storyId], references: [id], onDelete: SetNull)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Profile      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  reactions     MessageReaction[]
  notifications Notification[]
  transactions  Transaction[]

  @@index([senderId, createdAt])
  @@index([storyId])
  @@index([replyToId])
  @@index([createdAt])
  @@index([conversationId, createdAt(sort: Desc)])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  profileId String
  reaction  String // e.g. "❤️", "👍"
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([messageId, profileId])
  @@index([messageId])
  @@map("message_reactions")
}

// =============================================================================
// === Notifications
// =============================================================================

model Notification {
  // Retention: pruned by maintenance crons in src/maintenance/ (see InteractionEvent / PostView pattern).
  id          String           @id @default(uuid())
  recipientId String
  senderId    String?
  type        NotificationType
  content     String
  read        Boolean          @default(false)

  // Polymorphic References

  postId     String?
  storyId    String?
  reportId   String?
  messageId  String? // New: Link to affected DM for moderation alerts
  targetType String? // "post" | "story" | "comment" | "report" | "message"
  targetId   String?

  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  story   Story?   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  report  Report?  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  recipient Profile  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender    Profile? @relation("NotificationSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([recipientId, type, createdAt])
  @@index([recipientId, read, createdAt])
  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("notifications")
}

// =============================================================================
// === Monetization / Stripe
// =============================================================================

model PlatformPlan {
  id                  String   @id @default(uuid())
  name                String // e.g. "Pro Creator", "Verified"
  description         String?
  priceCents          Int      @default(0) // Source of truth (e.g. 999 = €9.99)
  yearlyPriceCents    Int? // INC-04: yearly price in cents
  currency            String   @default("EUR") // INC-13: Default to EUR
  interval            String   @default("month") // "month", "year"
  stripeProductId     String   @unique
  stripePriceId       String   @unique
  yearlyStripePriceId String?  @unique // INC-04: Support for yearly pricing
  features            String[] // Array of included features
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  subscriptions PlatformSubscription[]

  @@map("platform_plans")
}

model PlatformSubscription {
  id                   String             @id @default(uuid())
  userId               String
  planId               String
  status               SubscriptionStatus @default(ACTIVE) // Mapping Stripe statuses
  stripeSubscriptionId String             @unique
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan PlatformPlan @relation(fields: [planId], references: [id])

  @@unique([userId, planId])
  @@index([userId])
  @@index([status])
  @@map("platform_subscriptions")
}

model WebhookEvent {
  // Retention: prune processed/failed events via maintenance (src/maintenance/); do not grow unbounded.
  id          String    @id @default(uuid())
  provider    String // "stripe", "ccbill", "segpay"
  externalId  String    @unique // The event ID from the provider
  payload     Json
  status      String    @default("PENDING") // "PENDING", "PROCESSED", "FAILED"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?

  @@map("webhook_events")
}

model Promotion {
  id         String              @id @default(uuid())
  userId     String
  targetType PromotionTargetType
  targetId   String
  budgetCents Int                @default(0) // Remaining budget in cents
  currency   String              @default("EUR") // INC-13: Default to EUR
  status     PromotionStatus     @default(PENDING) // INC-02: Use enum and PENDING default
  startDate  DateTime            @default(now())
  endDate    DateTime
  reach      Int                 @default(0)
  clicks     Int                 @default(0)

  // Sponsored Placements Segmentation

  objective        String? @default("PROFILE_VISITS")
  interests        String?
  countries        String?
  dailyBudgetCents Int? // Daily cap in cents

  // Monetization: Checkout Session ID is stored in stripePaymentIntentId (legacy field name).

  // chargedAt is set on checkout.session.completed. Cancel refunds remaining budget when PROPORTIONAL.
  stripePaymentIntentId String?               @unique
  chargedAt             DateTime?
  refundPolicy          PromotionRefundPolicy @default(PROPORTIONAL)
  refundedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([targetType, targetId])
  @@index([status, endDate])
  @@map("promotions")
}

model Monetization {
  id     String @id @default(uuid())
  userId String @unique

  // Statistical ledger (platform fee share credited locally; funds settle in Connect)

  lifetimeEarningsCents Int     @default(0)
  // Cached from Stripe account.updated webhook
  transfersEnabled      Boolean @default(false)
  chargesEnabled        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("monetization")
}

model StripePayoutLog {
  id             String   @id @default(uuid())
  stripePayoutId String   @unique
  userId         String // Connected account owner
  amountCents    Int
  currency       String   @default("usd")
  status         String // 'paid', 'pending', 'failed', 'canceled'
  arrivalDate    DateTime
  failureReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@map("stripe_payout_logs")
}

model Transaction {
  id       String            @id @default(uuid())
  type     TransactionType
  amount   Int // Integer cents (legacy name; not amountCents — public money API contract)
  currency String            @default("EUR")
  status   TransactionStatus @default(COMPLETED)

  // Participants

  senderId   String?
  receiverId String?

  // Associated entities

  postId       String?
  storyId      String?
  messageId    String?
  promotionId  String?
  liveStreamId String?

  stripePaymentIntentId String? @unique

  description String?
  createdAt   DateTime @default(now())

  sender     User?       @relation("SentTransactions", fields: [senderId], references: [id], onDelete: SetNull)
  receiver   User?       @relation("ReceivedTransactions", fields: [receiverId], references: [id], onDelete: SetNull)
  liveStream LiveStream? @relation(fields: [liveStreamId], references: [id], onDelete: SetNull)
  liveGift   LiveGift?
  message    Message?    @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([senderId])
  @@index([receiverId])
  @@index([type])
  @@index([liveStreamId])
  @@map("transactions")
}

model PostUnlock {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  pricePaid Int // In cents
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("post_unlocks")
}

model MessageUnlock {
  id        String   @id @default(uuid())
  userId    String
  messageId String
  pricePaid Int // In cents
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@map("message_unlocks")
}

model StoryUnlock {
  id        String   @id @default(uuid())
  userId    String
  storyId   String
  pricePaid Int
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@map("story_unlocks")
}

// =============================================================================
// === Admin Panel
// =============================================================================

/// Admin Panel operator. Separate from platform User.
model AdminIdentity {
  id               String              @id @default(uuid())
  email            String              @unique
  passwordHash     String
  displayName      String
  status           AdminIdentityStatus @default(ACTIVE)
  totpSecret       String?
  totpEnabled      Boolean             @default(false)
  mfaRequired      Boolean             @default(true)
  lastLoginAt      DateTime?
  lastActivityAt   DateTime?
  failedLoginCount Int                 @default(0)
  lockedUntil      DateTime?
  linkedUserId     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  linkedUser      User?               @relation(fields: [linkedUserId], references: [id], onDelete: SetNull)
  roles           AdminIdentityRole[]
  refreshTokens   AdminRefreshToken[]
  passkeys        AdminPasskey[]
  auditLogs       AdminAuditLog[]
  assignedReports Report[]            @relation("ReportAssignedAdmin")

  @@index([linkedUserId])
  @@index([status])
  @@map("admin_identities")
}

model AdminRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  permissions AdminRolePermission[]
  identities  AdminIdentityRole[]

  @@map("admin_roles")
}

model AdminPermission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminRolePermission {
  roleId       String
  permissionId String

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminIdentityRole {
  adminId String
  roleId  String

  admin AdminIdentity @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role  AdminRole     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminId, roleId])
  @@map("admin_identity_roles")
}

model AdminRefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  adminId   String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  admin AdminIdentity @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_refresh_tokens")
}

model AdminPasskey {
  id           String   @id @default(uuid())
  adminId      String
  credentialID String   @unique
  publicKey    Bytes
  counter      BigInt
  transports   String[] @default([])
  createdAt    DateTime @default(now())

  admin AdminIdentity @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_passkeys")
}

model AdminAuditLog {
  // Retention: append-only audit trail; prune per compliance policy via maintenance crons (src/maintenance/).
  id           String      @id @default(uuid())
  adminId      String?
  legacyUserId String?
  action       AdminAction
  targetType   String // "user", "post", "report", "admin", "system"
  targetId     String
  details      String?
  ipAddress    String?
  userAgent    String?
  requestId    String?
  createdAt    DateTime    @default(now())

  admin AdminIdentity? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([legacyUserId])
  @@index([createdAt])
  @@index([action])
  @@index([targetId])
  @@map("admin_audit_logs")
}

model WhitelistEntry {
  id        String          @id @default(uuid())
  email     String          @unique
  name      String?
  status    WhitelistStatus @default(VALID)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("whitelist_entries")
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String

  @@map("system_settings")
}

model SupportTicket {
  id        String       @id @default(uuid())
  userId    String?
  email     String
  subject   String
  message   String
  status    TicketStatus @default(OPEN)
  reply     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

// =============================================================================
// === Moderation / Trust & Safety
// =============================================================================

model Report {
  id         String       @id @default(uuid())
  reporterId String
  reason     ReportReason @default(OTHER)
  details    String?
  status     ReportStatus @default(PENDING)

  // Target type
  targetType ReportTargetType
  targetId   String

  // Queue workflow (Admin Panel operator, not platform User)

  assignedAdminId String?
  assignedAdmin   AdminIdentity? @relation("ReportAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  resolvedAt      DateTime?
  internalNotes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reporter      Profile        @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([status, createdAt])
  @@index([assignedAdminId])
  @@index([resolvedAt])
  @@map("reports")
}

model Appeal {
  id         String           @id @default(uuid())
  userId     String
  targetType AppealTargetType
  targetId   String?
  reason     String
  status     AppealStatus     @default(PENDING)
  adminNotes String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("appeals")
}

model ModerationRule {
  id        String     @id @default(uuid())
  keyword   String     @unique
  action    RuleAction @default(FLAG)
  isActive  Boolean    @default(true)
  createdBy String // ID del admin

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("moderation_rules")
}

model ModerationSignature {
  id          String                      @id @default(uuid())
  vector      Unsupported("vector(1536)")
  category    String // e.g., "hate", "sexual", "spam", "scam"
  textPreview String? // The source text that generated this vector
  createdAt   DateTime                    @default(now())

  @@map("moderation_signatures")
}

// =============================================================================
// === Growth / Experiments
// =============================================================================

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(false)
  percentage  Int      @default(0) // 0 to 100
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

model UserExperiment {
  id            String   @id @default(uuid())
  userId        String
  experimentKey String
  variant       String // e.g., "control", "treatment", "true", "false"
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, experimentKey])
  @@index([experimentKey])
  @@map("user_experiments")
}

model InteractionEvent {
  // Retention: high-volume analytics; prune old rows via maintenance crons in src/maintenance/.
  id         String        @id @default(uuid())
  userId     String? // Nullable for anonymous guests
  eventType  UserEventType
  targetId   String // Polymorphic ID (Post, User, Story, etc.)
  targetType String // "POST", "STORY", "USER", "PROMOTION"
  dwellTime  Int? // Dwell duration in milliseconds
  createdAt  DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([targetId, eventType])
  @@index([createdAt])
  @@map("interaction_events")
}

// =============================================================================
// === Feed Preferences / Analytics / Vectors
// =============================================================================

model FeedHiddenPost {
  id        String   @id @default(uuid())
  profileId String
  postId    String
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([profileId, postId])
  @@index([profileId])
  @@map("feed_hidden_posts")
}

model FeedHiddenAuthor {
  id        String   @id @default(uuid())
  profileId String
  authorId  String
  createdAt DateTime @default(now())

  profile Profile @relation("FeedHidingAuthor", fields: [profileId], references: [id], onDelete: Cascade)
  author  Profile @relation("FeedHiddenAsAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([profileId, authorId])
  @@index([profileId])
  @@map("feed_hidden_authors")
}

model FeedMutedKeyword {
  id        String   @id @default(uuid())
  profileId String
  keyword   String
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, keyword])
  @@index([profileId])
  @@map("feed_muted_keywords")
}

model PostView {
  // Retention: high-volume view log; prune via maintenance crons in src/maintenance/.
  id        String   @id @default(uuid())
  postId    String
  viewerId  String? // Optional: tracking anonymous or identified views
  createdAt DateTime @default(now())

  post   Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  viewer Profile? @relation(fields: [viewerId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
  @@index([viewerId])
  @@map("post_views")
}

model ProfileMetric {
  id        String   @id @default(uuid())
  profileId String
  date      DateTime @default(now())

  // Snapshots
  followers Int @default(0)
  following Int @default(0)
  posts     Int @default(0)
  likes     Int @default(0)
  views     Int @default(0)
  reach     Int @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, date])
  @@map("profile_metrics")
}

model PostEmbedding {
  postId String                      @id
  vector Unsupported("vector(1536)") // Native pgvector storage
  post   Post                        @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("post_embeddings")
}

model ProfileEmbedding {
  profileId String                      @id
  vector    Unsupported("vector(1536)") // Native pgvector storage
  profile   Profile                     @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("profile_embeddings")
}

