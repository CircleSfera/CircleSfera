{
  "name": "circlesfera-frontend",
  "version": "1.0.0",
  "description": "CircleSfera Frontend - Social Media Web Application",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome lint . && node scripts/check-i18n-keys.mjs && node scripts/check-api-routes.mjs && node scripts/check-editor-text-size.mjs && node scripts/check-button-width.mjs && node scripts/check-android-plugins.mjs",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:deps": "node ../scripts/check-module-boundaries.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "env -u NO_COLOR FORCE_COLOR=0 playwright test",
    "test:e2e:ui": "env -u NO_COLOR FORCE_COLOR=0 playwright test --ui",
    "test:e2e:sizes": "env -u NO_COLOR FORCE_COLOR=0 playwright test e2e/editor-control-sizes.spec.ts",
    "test:e2e:composer": "env -u NO_COLOR FORCE_COLOR=0 playwright test e2e/composer-smoke.spec.ts e2e/composer-visual.spec.ts",
    "test:e2e:composer:update": "env -u NO_COLOR FORCE_COLOR=0 playwright test e2e/composer-visual.spec.ts --update-snapshots",
    "cap:sync": "vite build && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "lint:i18n": "node scripts/check-i18n-keys.mjs"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "fast-uri": "4.2.3",
    "fflate": "0.8.3",
    "socket.io-parser": "4.2.7",
    "tar": "7.5.22",
    "uuid": "14.0.3",
    "sharp": "0.35.5",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@capgo/capacitor-native-biometric": "8.9.3",
    "@circlesfera/shared": "file:../circlesfera-shared",
    "@erase2d/fabric": "1.2.2",
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@fingerprintjs/fingerprintjs": "5.3.0",
    "@livekit/components-react": "2.9.25",
    "@livekit/components-styles": "1.2.0",
    "@mapbox/search-js-react": "1.6.0",
    "@sentry/browser": "11.12.0",
    "@sentry/react": "11.12.0",
    "@sentry/tracing": "7.120.4",
    "@simplewebauthn/browser": "14.0.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-virtual": "3.14.26",
    "axios": "1.21.1",
    "clsx": "2.1.1",
    "fabric": "7.4.0",
    "framer-motion": "14.14.0",
    "hls.js": "1.7.4",
    "html-to-image": "1.11.13",
    "i18next": "27.1.1",
    "i18next-browser-languagedetector": "8.3.0",
    "konva": "10.9.1",
    "livekit-client": "2.24.0",
    "lucide-react": "1.73.0",
    "mapbox-gl": "3.35.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-easy-crop": "6.2.5",
    "react-helmet-async": "3.1.0",
    "react-hot-toast": "2.6.1",
    "react-i18next": "18.0.1",
    "react-konva": "19.3.2",
    "react-masonry-css": "1.0.16",
    "react-router-dom": "7.18.5",
    "recharts": "3.10.1",
    "socket.io-client": "4.8.4",
    "use-image": "1.1.4",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@capacitor/android": "8.6.2",
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@napi-rs/canvas": "1.1.1",
    "@playwright/test": "1.65.1",
    "@swc/core": "1.16.22",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "autoprefixer": "10.6.2",
    "dependency-cruiser": "18.7.2",
    "jsdom": "31.0.1",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "@swc/core": true,
    "canvas": true,
    "fsevents": true
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  }
}
