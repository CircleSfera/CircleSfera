{
  "name": "circlesfera-frontend",
  "version": "1.0.0",
  "description": "CircleSfera Frontend - Social Media Web Application",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:deps": "depcruise src",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "env -u NO_COLOR FORCE_COLOR=0 playwright test",
    "test:e2e:ui": "env -u NO_COLOR FORCE_COLOR=0 playwright test --ui",
    "test:e2e:composer": "env -u NO_COLOR FORCE_COLOR=0 playwright test e2e/composer-smoke.spec.ts e2e/composer-visual.spec.ts",
    "test:e2e:composer:update": "env -u NO_COLOR FORCE_COLOR=0 playwright test e2e/composer-visual.spec.ts --update-snapshots",
    "cap:sync": "vite build && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "fast-uri": "4.1.4",
    "fflate": "0.8.3",
    "socket.io-parser": "4.2.7",
    "tar": "7.5.22",
    "uuid": "11.1.1",
    "sharp": "0.35.4",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@5": "5.0.9",
    "qs": "6.16.0"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/camera": "8.2.4",
    "@capacitor/core": "8.5.1",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@capgo/capacitor-native-biometric": "8.6.7",
    "@circlesfera/shared": "file:../circlesfera-shared",
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@fingerprintjs/fingerprintjs": "5.2.0",
    "@livekit/components-react": "2.9.24",
    "@livekit/components-styles": "1.2.0",
    "@mapbox/search-js-react": "1.6.0",
    "@sentry/browser": "10.73.0",
    "@sentry/react": "10.73.0",
    "@sentry/tracing": "7.120.4",
    "@simplewebauthn/browser": "14.0.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-virtual": "3.14.11",
    "axios": "1.20.0",
    "clsx": "2.1.1",
    "fabric": "7.4.0",
    "framer-motion": "13.2.0",
    "hls.js": "1.7.2",
    "html-to-image": "1.11.13",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "konva": "10.3.3",
    "livekit-client": "2.22.3",
    "lucide-react": "1.42.0",
    "mapbox-gl": "3.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-easy-crop": "6.2.3",
    "react-helmet-async": "3.0.0",
    "react-hot-toast": "2.6.0",
    "react-i18next": "17.0.13",
    "react-konva": "19.2.6",
    "react-masonry-css": "1.0.16",
    "react-router-dom": "7.18.3",
    "recharts": "3.10.1",
    "socket.io-client": "4.8.3",
    "use-image": "1.1.4",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@capacitor/android": "8.5.1",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.1",
    "@capacitor/ios": "8.5.1",
    "@playwright/test": "1.63.0",
    "@prisma/client": "7.10.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/ui": "5.0.1",
    "autoprefixer": "10.5.5",
    "dependency-cruiser": "18.2.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@biomejs/biome@2.5.12": true
  }
}
