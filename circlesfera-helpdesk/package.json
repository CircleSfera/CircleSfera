{
  "name": "circlesfera-helpdesk",
  "version": "0.1.0",
  "description": "Help Desk - a product of its own, with CircleSfera as its first customer (ADR-0034)",
  "author": "CircleSfera Team",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:prod": "node dist/main.js",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "check:deps": "node ../scripts/check-module-boundaries.mjs",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:check-migrations": "../scripts/check-prisma-schema-migrations.sh circlesfera-helpdesk HELPDESK_DATABASE_URL",
    "postinstall": "prisma generate"
  },
  "overrides": {
    "fast-uri": "4.2.3",
    "qs": "6.17.1",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.6",
    "effect": "3.22.5",
    "multer": "2.5.0"
  },
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.10",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@nestjs/testing": "12.6.0",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.1",
    "dependency-cruiser": "18.8.0",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "typescript": "7.0.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "@swc/core": true,
    "fsevents": true,
    "prisma": true
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  }
}
