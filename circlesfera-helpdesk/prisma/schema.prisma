// Help Desk Prisma schema: the Help Desk's own database (ADR-0034).
// Docs: https://pris.ly/d/prisma-schema
//
// Step 1 of the move: the Help Desk models of circlesfera-backend, copied as
// they are, with the same table and column names so the existing tickets can
// be copied row for row in a later step. What changes is only what cannot
// cross databases: the relations to the host's tables (User, Report) are gone
// and their columns are opaque references the host understands (ADR-0027).
// Every record keeps its organization, directly or through its ticket.
//
// Agents' own sign-in comes in step 2: there is no agent or sign-in model yet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// === Organizations
// =============================================================================

// The company that runs a Help Desk. CircleSfera is the first.
model HelpdeskOrganization {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  locales   String[]
  timeZone  String   @default("Europe/Madrid")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets        SupportTicket[]
  savedReplies   HelpdeskSavedReply[]
  inboundEmails  HelpdeskInboundEmail[]
  serviceTargets HelpdeskServiceTarget[]
  ratings        HelpdeskRating[]
  articles       HelpdeskArticle[]

  @@map("helpdesk_organizations")
}

// =============================================================================
// === Tickets
// =============================================================================

model SupportTicket {
  id         String         @id @default(uuid())
  // The requester, as the host names them (for CircleSfera, the User id).
  // An opaque reference: no relation, the host's tables are not here.
  userId     String?
  email      String
  subject    String
  message    String
  status     TicketStatus   @default(OPEN)
  // What the ticket is about, chosen by who writes it
  category   TicketCategory @default(OTHER)
  reply      String?
  resolvedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  // The Help Desk organization the ticket belongs to
  organizationId     String
  // Short number shown to requester and agent
  reference          Int                  @unique @default(autoincrement())
  // Only agents see it
  priority           HelpdeskPriority     @default(NORMAL)
  // Who of the team has the ticket, as the host names them; empty when
  // nobody has it
  assignedAgentRef   String?
  // When the one reminder of the current wait was sent
  waitingRemindedAt  DateTime?
  // The closed ticket this one continues, when it was opened by replying
  // to it
  previousTicketId   String?
  // What the ticket is measured by, taken when it is opened
  serviceLevel       HelpdeskServiceLevel @default(STANDARD)
  firstResponseDueAt DateTime?
  // The first public answer of an agent
  firstRespondedAt   DateTime?
  // Moves forward by the time the clock was stopped
  resolutionDueAt    DateTime?
  // When the clock stopped: the ticket is not open. Empty while it runs
  pausedAt           DateTime?

  // The case opened with the host's other team when the ticket was handed
  // over, as the host names it. An opaque reference: no relation.
  escalatedReportId String? @unique

  organization   HelpdeskOrganization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  messages       HelpdeskMessage[]
  events         HelpdeskTicketEvent[]
  previousTicket SupportTicket?         @relation("TicketContinuation", fields: [previousTicketId], references: [id], onDelete: SetNull)
  continuations  SupportTicket[]        @relation("TicketContinuation")
  inboundEmails  HelpdeskInboundEmail[]
  rating         HelpdeskRating?

  @@index([userId])
  @@index([status])
  @@index([resolvedAt])
  @@index([organizationId, status, createdAt])
  @@index([previousTicketId])
  @@index([organizationId, assignedAgentRef, status])
  @@index([organizationId, status, resolutionDueAt])
  @@map("support_tickets")
}

// One thing said in a ticket. Append-only.
model HelpdeskMessage {
  id         String                    @id @default(uuid())
  ticketId   String
  authorKind HelpdeskAuthorKind
  // Who wrote it, as the host names them. Empty for the system and for
  // answers from before authors were stored.
  authorRef  String?
  visibility HelpdeskMessageVisibility @default(PUBLIC)
  body       String
  channel    HelpdeskMessageChannel    @default(PRODUCT)
  createdAt  DateTime                  @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("helpdesk_messages")
}

// One change of a ticket and who made it. Append-only; the history agents
// see.
model HelpdeskTicketEvent {
  id        String             @id @default(uuid())
  ticketId  String
  kind      HelpdeskEventKind
  fromValue String?
  toValue   String?
  actorKind HelpdeskAuthorKind
  actorRef  String?
  createdAt DateTime           @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("helpdesk_ticket_events")
}

// What the requester thought of the answer. One per ticket.
model HelpdeskRating {
  id             String              @id @default(uuid())
  organizationId String
  ticketId       String              @unique
  score          HelpdeskRatingScore
  comment        String?             @db.VarChar(500)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization HelpdeskOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ticket       SupportTicket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("helpdesk_ratings")
}

// =============================================================================
// === Agents' tools
// =============================================================================

// An answer an agent keeps for a repeated question. It only fills the reply
// box; it is never sent on its own.
model HelpdeskSavedReply {
  id             String   @id @default(uuid())
  organizationId String
  title          String   @db.VarChar(120)
  body           String
  // The agent who owns it, as the host names them. Empty when the whole
  // team shares it.
  ownerRef       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization HelpdeskOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, ownerRef])
  @@map("helpdesk_saved_replies")
}

// The targets of an organization for one service level, in minutes on the
// clock.
model HelpdeskServiceTarget {
  id                   String               @id @default(uuid())
  organizationId       String
  serviceLevel         HelpdeskServiceLevel
  firstResponseMinutes Int
  resolutionMinutes    Int
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  organization HelpdeskOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, serviceLevel])
  @@map("helpdesk_service_targets")
}

// =============================================================================
// === Help centre
// =============================================================================

// An article of the help centre: it answers one question for anyone,
// without a ticket. Its words are in HelpdeskArticleText, one per language.
model HelpdeskArticle {
  id             String                @id @default(uuid())
  organizationId String
  // Its name in its address; the same in every language
  slug           String                @db.VarChar(120)
  topic          TicketCategory        @default(OTHER)
  status         HelpdeskArticleStatus @default(DRAFT)
  // Its place inside its topic
  position       Int                   @default(0)
  // How many readers said it helped, and how many said it did not
  usefulYes      Int                   @default(0)
  usefulNo       Int                   @default(0)
  // Who of the staff wrote it, as the host names them
  authorRef      String?
  publishedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization HelpdeskOrganization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  texts        HelpdeskArticleText[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, topic, position])
  @@map("helpdesk_articles")
}

// The title and the body of an article in one language. The body is text,
// never HTML.
model HelpdeskArticleText {
  id        String   @id @default(uuid())
  articleId String
  locale    String   @db.VarChar(10)
  title     String   @db.VarChar(150)
  body      String
  updatedAt DateTime @updatedAt

  article HelpdeskArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
  @@map("helpdesk_article_texts")
}

// =============================================================================
// === Email in
// =============================================================================

// An email that arrived at a reply address. Kept for 30 days; what matters
// of a matched one lives on as the message of its ticket.
model HelpdeskInboundEmail {
  id              String                 @id @default(uuid())
  organizationId  String
  // The Message-ID of the email: the same email delivered twice is kept once
  messageId       String
  fromAddress     String
  toAddress       String
  subject         String
  // Its text, without quoted replies when the mail provider cut them
  body            String
  spamScore       Float?
  attachmentCount Int                    @default(0)
  // Its headers say a machine sent it
  automated       Boolean                @default(false)
  outcome         HelpdeskInboundOutcome @default(RECEIVED)
  ticketId        String?
  // When the sender was told their email matched no request
  noticeSentAt    DateTime?
  receivedAt      DateTime               @default(now())

  organization HelpdeskOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ticket       SupportTicket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@unique([organizationId, messageId])
  @@index([organizationId, outcome, receivedAt])
  @@index([receivedAt])
  @@index([ticketId])
  @@map("helpdesk_inbound_emails")
}

// =============================================================================
// === Enums
// =============================================================================

enum TicketCategory {
  ACCOUNT
  PAYMENTS
  CONTENT
  OTHER
}

enum TicketStatus {
  OPEN
  RESOLVED
  CLOSED
  // Handed to another team of the host: that team decides it
  ESCALATED
  // The team asked something and waits for the requester
  WAITING
}

enum HelpdeskAuthorKind {
  REQUESTER
  AGENT
  SYSTEM
}

enum HelpdeskMessageVisibility {
  PUBLIC
  INTERNAL
}

enum HelpdeskMessageChannel {
  PRODUCT
  EMAIL
}

enum HelpdeskPriority {
  LOW
  NORMAL
  HIGH
}

enum HelpdeskArticleStatus {
  DRAFT
  PUBLISHED
}

// How fast a requester is to be answered.
enum HelpdeskServiceLevel {
  STANDARD
  PRIORITY
}

enum HelpdeskRatingScore {
  GOOD
  BAD
}

// What became of an email that arrived at a reply address.
enum HelpdeskInboundOutcome {
  // Kept, not looked at yet
  RECEIVED
  // It is a message of its ticket
  MATCHED
  // Not sent to the address of a ticket
  NO_TICKET
  // Sent to a ticket by someone who is not its requester
  SENDER_MISMATCH
  // Nothing left once quoted text was cut
  EMPTY
  // Out-of-office answers, bounces, lists
  AUTOMATED
  SPAM
}

enum HelpdeskEventKind {
  STATE
  TOPIC
  PRIORITY
  ASSIGNMENT
  HANDOVER
}
