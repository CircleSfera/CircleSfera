{
  "name": "@circlesfera/shared",
  "version": "1.0.0",
  "description": "Shared types and enums for CircleSfera",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:deps": "node ../scripts/check-module-boundaries.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@prisma/client": "7.10.1",
    "@swc/core": "1.16.21",
    "dependency-cruiser": "18.7.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "allowScripts": {
    "@swc/core": true
  }
}
