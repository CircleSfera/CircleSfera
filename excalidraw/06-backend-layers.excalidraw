    {
      "id": "m06-bt-0065",
      "type": "text",
      "x": 868,
      "y": 153.125,
      "width": 464,
      "height": 113.75,
      "angle": 0,
      "strokeColor": "#3949AB",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 101105,
      "version": 1,
      "versionNonce": 101105,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788018447123,
      "link": null,
      "locked": false,
      "text": "Globals (app.module.ts)\nAPP_PIPE ValidationPipe\nAPP_GUARD ThrottlerGuard\nAPP_FILTER AllExceptionsFilter\nLogger nestjs-pino (redact cookies + authorization)\nScheduleModule \u00b7 EventEmitterModule (in-process only)\nRedisCacheModule \u00b7 BullModule",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "m06-b-0064",
      "originalText": "Globals (app.module.ts)\nAPP_PIPE ValidationPipe\nAPP_GUARD ThrottlerGuard\nAPP_FILTER AllExceptionsFilter\nLogger nestjs-pino (redact cookies + authorization)\nScheduleModule \u00b7 EventEmitterModule (in-process only)\nRedisCacheModule \u00b7 BullModule",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "m06-b-0066",
      "type": "rectangle",
      "x": 860,
