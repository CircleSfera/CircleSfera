      "version": 1,
      "text": "Cookies httpOnly: access_token 15m + refresh_token 7d  (RefreshToken table, rotate)\nCurrentUserData: userId (sub) + profileId  (primary profile; findFirst by userId — multi-profile schema exists but product v1 is one primary)\nAdmin cookies: admin_access_token 10m, admin_refresh_token 8h, host-only",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cookies httpOnly: access_token 15m + refresh_token 7d  (RefreshToken table, rotate)\nCurrentUserData: userId (sub) + profileId  (primary profile; findFirst by userId — multi-profile schema exists but product v1 is one primary)\nAdmin cookies: admin_access_token 10m, admin_refresh_token 8h, host-only",
      "autoResize": false,
      "lineHeight": 1.25
    },
