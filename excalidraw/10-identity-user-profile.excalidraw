      "version": 1,
      "text": "Separate login on admin.circlesfera.com\n\nRBAC\nAdminRole, AdminPermission\nAdminRolePermission, AdminIdentityRole\n\nMFA mandatory\nAdminPasskey, AdminRefreshToken\nAdminAuditLog\n\nPlatform User.role does NOT grant\nadmin-panel access\n\nReport.assignedAdminId → AdminIdentity",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Separate login on admin.circlesfera.com\n\nRBAC\nAdminRole, AdminPermission\nAdminRolePermission, AdminIdentityRole\n\nMFA mandatory\nAdminPasskey, AdminRefreshToken\nAdminAuditLog\n\nPlatform User.role does NOT grant\nadmin-panel access\n\nReport.assignedAdminId → AdminIdentity",
      "autoResize": false,
      "lineHeight": 1.25
    },
