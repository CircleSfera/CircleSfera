      "link": null,
      "locked": false,
      "version": 1,
      "text": "username UNIQUE\ncanonical public handle @username\nfullName, bio, avatar / cover\nisAccountBanned, accountBanReason, suspendedUntil\n\nALL content / social FKs\nposts, stories, comments, likes\nfollows, blocks, mutes\nbookmarks, collections, notifications\nchat, live host, poll votes, QnA\nreports as reporter, search history\nclose friends, highlights, edits\n\nURL: /:username\nAPI: GET /profiles/:username\nme: GET /profiles/me via JWT profileId",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "username UNIQUE\ncanonical public handle @username\nfullName, bio, avatar / cover\nisAccountBanned, accountBanReason, suspendedUntil\n\nALL content / social FKs\nposts, stories, comments, likes\nfollows, blocks, mutes\nbookmarks, collections, notifications\nchat, live host, poll votes, QnA\nreports as reporter, search history\nclose friends, highlights, edits\n\nURL: /:username\nAPI: GET /profiles/:username\nme: GET /profiles/me via JWT profileId",
      "autoResize": false,
      "lineHeight": 1.25
    },
