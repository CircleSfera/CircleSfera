# The settings of one environment that is not production (staging or dev).
# Names only: the values live in the repository secret ENV_STAGING_B64 or
# ENV_DEV_B64 (this file, filled in and base64-encoded). Every secret value
# is new for the environment; none is copied from production, and the deploy
# refuses a file that shares one with it.
#
# Replace <name> with staging or dev.

# --- Required
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
REDIS_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ADMIN_SECRET=
CSRF_SECRET=
ENCRYPTION_KEY=
ABUSE_HASH_PEPPER=
FRONTEND_URL=https://<name>.circlesfera.com
CORS_ORIGIN=https://<name>.circlesfera.com,https://admin.<name>.circlesfera.com,https://backoffice.<name>.circlesfera.com
WEBAUTHN_RP_ID=<name>.circlesfera.com
WEBAUTHN_ORIGIN=https://<name>.circlesfera.com
VITE_API_URL=https://<name>.circlesfera.com/api/v1

# --- Payments: test keys only (sk_test_...). A live key stops the deploy.
# Required: the backend refuses to start without the three of them. They come
# from the environment's own sandbox at the payment provider.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_METHOD_CONFIGURATION=
# The secret of the sandbox's second destination, the one for creator accounts
# and payouts. Without it the backend starts, and refuses those notices.
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Also required: the backend refuses to start without a value for each.
# TURNSTILE_SECRET_KEY and its site key: the environment is behind a password
# already, so the provider's public test pair (always passes) is enough.
# OPENAI_API_KEY: any value starts the backend; with one that is not a real
# key the assistant features answer with an error and nothing is spent.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
OPENAI_API_KEY=

# --- Must stay empty: the environment sends no email and no push.
BREVO_API_KEY=
SMTP_PASS=
VAPID_PRIVATE_KEY=
# Push to the iOS app: the Apple token key (.p8) in base64.
APNS_KEY=

# --- Optional. Left empty, the feature is off in the environment.
SENTRY_DSN=
VITE_SENTRY_DSN=
VITE_MAPBOX_ACCESS_TOKEN=

# --- Live broadcasts. Required: the backend refuses to start without the key
# and the secret. With LIVEKIT_URL set to the
# environment's own address, the deploy starts the environment's own live
# service and recorder; the key and the secret are invented for it (the
# secret at least 32 characters) and are not the hosted service's.
# The server's firewall must let in the media ports: staging 7891/tcp and
# 7892/udp, dev 7893/tcp and 7894/udp.
LIVEKIT_URL=wss://<name>.circlesfera.com
VITE_LIVEKIT_URL=wss://<name>.circlesfera.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
