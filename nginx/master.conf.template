# CircleSfera Internal Proxy Configuration (Port 80 inside Docker)

# The web app's Content Security Policy, enforced: a browser refuses whatever
# it does not list, and reports it to the backend. Origins: the app and its
# API (self), realtime sockets, LiveKit, Sentry, Mapbox and Cloudflare
# Turnstile; blob: and wasm for the video editor (ffmpeg) and map workers.
# connect-src takes blob: and data: because the video editor reads its own
# blob: copies of ffmpeg and of the clips, and a data: picture, with fetch.
# The pages are served on circlesfera.com only (www moves there, below), so
# the API the app calls is always the page's own origin.
#
# It describes the pages of the app, so API answers do not carry it: they are
# data, and the backend sends its own policy with them. An empty value sends
# no header. Every header added here also counts against the response header
# buffer of the server in front of this proxy, and a sign-in answer already
# carries two session cookies.
map $uri $web_app_csp {
    ~^/api/ "";
    default "default-src 'self'; script-src 'self' blob: 'wasm-unsafe-eval' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' blob: data: wss://circlesfera.com wss://staging.circlesfera.com wss://dev.circlesfera.com https://*.livekit.cloud wss://*.livekit.cloud https://*.ingest.de.sentry.io https://api.mapbox.com https://events.mapbox.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; report-uri /api/v1/security/csp-report";
}

# 1. Unified Proxy (Landing & API)
server {
    listen 80;
    # Staging and development run this same file behind their own host
    # sites, so they answer through the servers production uses, with the
    # same headers and routes, and are checked as production will be.
    server_name circlesfera.com www.circlesfera.com staging.circlesfera.com dev.circlesfera.com;

    # The site has one address: a page asked on www moves to circlesfera.com.
    # The API, the sockets and the app-link files still answer on www: the
    # Android app lists www among its link hosts and Android reads
    # /.well-known/assetlinks.json there without following a redirect, and
    # the deploy checks the health route through every public address. The
    # service worker answers too: a browser never follows a redirect for it,
    # so an app installed on www could not update to the build that moves it.
    set $www_page "";
    if ($host = "www.circlesfera.com") {
        set $www_page "yes";
    }
    if ($uri ~ "^/(api/|socket\.io/|\.well-known/|service-worker\.js$)") {
        set $www_page "";
    }
    if ($www_page = "yes") {
        return 301 https://circlesfera.com$request_uri;
    }

    # Bounded client payload and request buffer defaults
    client_max_body_size 10m;
    client_body_buffer_size 128k;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # The web app itself needs camera and microphone (live, calls, voice
    # messages) and location (composer, map); other sites embedding it do not.
    add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=(self)" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    # Content Security Policy for the web app. The policy and the answers
    # that carry it are defined at the top of this file.
    add_header Content-Security-Policy $web_app_csp always;
    # nginx owns these headers; drop the backend copies so each is sent once.
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Strict-Transport-Security;

    # Bounded default timeouts: prevent slowloris and hung backend connections
    client_body_timeout 30s;
    send_timeout 30s;
    proxy_connect_timeout 10s;
    proxy_send_timeout 30s;
    proxy_read_timeout 60s;

    # Standard response buffering: Nginx buffers backend responses to release Node.js quickly
    proxy_buffering on;
    proxy_buffers 8 16k;
    proxy_buffer_size 16k;
    proxy_busy_buffers_size 32k;
    proxy_request_buffering on;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json;
    gzip_disable "MSIE [1-6]\.";

    # Dynamic resolution to prevent startup crashes
    resolver 127.0.0.11 valid=30s;
    set $backend_upstream http://backend:${BACKEND_PORT};
    set $frontend_upstream http://frontend:${FRONTEND_PORT};

    # Realtime WebSocket Proxy (Prefixed) - Unbuffered with 3600s keepalive
    location /api/v1/socket.io/ {
        proxy_pass $backend_upstream/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Realtime streaming exceptions
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Realtime WebSocket Proxy - Unbuffered with 3600s keepalive
    location /socket.io/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Realtime streaming exceptions
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Media & File Uploads Exception (100MB body, unbuffered streaming to backend)
    location /api/v1/uploads {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # High-volume upload exceptions
        client_max_body_size 100m;
        client_body_buffer_size 16M;
        client_body_timeout 300s;
        proxy_connect_timeout 15s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_request_buffering off;
    }

    # GDPR Large Export Archive Download (Unbuffered streaming)
    location ~ ^/api/v1/users/gdpr/exports/[^/]+/download$ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Streaming export exceptions
        proxy_buffering off;
        proxy_read_timeout 300s;
        send_timeout 300s;
    }

    # API Proxy (Global v1 - Bounded Defaults)
    location /api/v1/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Conservative bounded defaults
        client_max_body_size 10m;
        client_body_buffer_size 128k;
        client_body_timeout 30s;
        send_timeout 30s;
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 60s;
        proxy_buffering on;
        proxy_request_buffering on;
    }

    # Media delivery with per-file authorization via auth_request.
    location /uploads/ {
        auth_request /internal/media-auth;
        auth_request_set $auth_status $upstream_status;

        alias /usr/share/nginx/html/uploads/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    # Internal auth subrequest — not reachable from the public internet.
    location = /internal/media-auth {
        internal;
        proxy_pass $backend_upstream/api/v1/media/auth-check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Strict internal timeouts
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        proxy_send_timeout 10s;
    }

    # SEO Endpoints Proxy
    location = /sitemap.xml {
        proxy_pass $backend_upstream/api/v1/sitemap.xml;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The parts the site map index lists, at the root so that each may list
    # any address of the site.
    location ~ ^/sitemap-(pages|profiles|posts)-([0-9]+)\.xml$ {
        proxy_pass $backend_upstream/api/v1/sitemap/$1/$2;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /robots.txt {
        proxy_pass $backend_upstream/api/v1/robots.txt;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    # App links: iOS and Android fetch these files to open circlesfera.com
    # links in the native apps. They must be JSON, served without redirects.
    location = /.well-known/apple-app-site-association {
        proxy_pass $backend_upstream/api/v1/.well-known/apple-app-site-association;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /.well-known/assetlinks.json {
        proxy_pass $backend_upstream/api/v1/.well-known/assetlinks.json;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Frontend App
    location / {
        if ($http_upgrade = "websocket") {
            proxy_pass $frontend_upstream;
        }
        proxy_pass $frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# 2. Staging and development are not separate servers here: each runs this
# file in its own proxy, behind its own host site and password
# (infra/host/nginx/sites/), and the servers above name their addresses.

# 3. Local Development (localhost; the default server, so media keeps its auth)
server {
    listen 80 default_server;
    server_name localhost 127.0.0.1;

    # Bounded client payload and request buffer defaults
    client_max_body_size 10m;
    client_body_buffer_size 128k;

    # Bounded default timeouts
    client_body_timeout 30s;
    send_timeout 30s;
    proxy_connect_timeout 10s;
    proxy_send_timeout 30s;
    proxy_read_timeout 60s;

    # Standard response buffering
    proxy_buffering on;
    proxy_buffers 8 16k;
    proxy_buffer_size 16k;
    proxy_busy_buffers_size 32k;
    proxy_request_buffering on;

    resolver 127.0.0.11 valid=30s;
    set $frontend_upstream http://frontend:${FRONTEND_PORT};
    set $backend_upstream http://backend:${BACKEND_PORT};

    # Realtime WebSocket Proxy (Prefixed)
    location /api/v1/socket.io/ {
        rewrite ^/api/v1/socket.io/(.*)$ /socket.io/$1 break;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Standard Socket.io Proxy
    location /socket.io/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Media & File Uploads Exception
    location /api/v1/uploads {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        client_max_body_size 100m;
        client_body_buffer_size 16M;
        client_body_timeout 300s;
        proxy_connect_timeout 15s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_request_buffering off;
    }

    # GDPR Large Export Archive Download
    location ~ ^/api/v1/users/gdpr/exports/[^/]+/download$ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_read_timeout 300s;
        send_timeout 300s;
    }

    # Backend API Proxy (Bounded Defaults)
    location /api/v1/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        client_max_body_size 10m;
        client_body_buffer_size 128k;
        client_body_timeout 30s;
        send_timeout 30s;
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 60s;
        proxy_buffering on;
        proxy_request_buffering on;
    }

    # Media delivery with per-file authorization via auth_request, as on the
    # named sites: this server is the default one, so any request whose
    # address names no other site lands here, and must not get files the
    # named sites protect.
    location /uploads/ {
        auth_request /internal/media-auth;
        auth_request_set $auth_status $upstream_status;

        alias /usr/share/nginx/html/uploads/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    # Internal auth subrequest — not reachable from the public internet.
    location = /internal/media-auth {
        internal;
        proxy_pass $backend_upstream/api/v1/media/auth-check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Strict internal timeouts
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        proxy_send_timeout 10s;
    }

    # Vite Frontend & HMR
    location / {
        proxy_pass $frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

