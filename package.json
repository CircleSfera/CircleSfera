{
  "name": "circlesfera",
  "version": "1.0.0",
  "description": "CircleSfera - Your World, Connected.",
  "main": "index.js",
  "scripts": {
    "test:e2e": "env -u NO_COLOR FORCE_COLOR=0 npx playwright test",
    "e2e:db:up": "docker compose -p circlesfera-e2e -f docker-compose.e2e.yml up -d",
    "e2e:db:down": "docker compose -p circlesfera-e2e -f docker-compose.e2e.yml down",
    "e2e:db:migrate": "cd circlesfera-backend && DATABASE_URL=\"${E2E_DATABASE_URL:-postgresql://prisma:prisma@localhost:5433/circlesfera_e2e?schema=public}\" npx prisma migrate deploy",
    "e2e:cleanup": "cd circlesfera-backend && npx tsx scripts/cleanup-e2e-users.ts",
    "smoke:profile-drift": "node scripts/validate-profile-drift-smoke.mjs",
    "docs:api-inventory": "node scripts/generate-api-inventory.mjs",
    "db:backup": "./scripts/backup-postgres.sh",
    "db:restore": "./scripts/restore-postgres.sh",
    "db:verify-restore": "./scripts/verify-backup-restore.sh",
    "db:check-migrations": "./scripts/check-prisma-schema-migrations.sh",
    "db:lint-migrations": "node scripts/lint-migration-safety.mjs",
    "db:test-rollback": "./scripts/test-migration-rollback.sh",
    "env:upload": "./scripts/upload-prod-env.sh",
    "ops:diagnose-crypto": "node scripts/diagnose-message-crypto.mjs",
    "repo:verify-protection": "node scripts/verify-branch-protection.mjs",
    "repo:enforce-protection": "node scripts/verify-branch-protection.mjs --enforce",
    "nginx:lint": "node scripts/test-nginx-config.mjs",
    "docker:verify-digests": "node scripts/verify-container-digests.mjs",
    "audit:deps": "node scripts/audit-dependencies.mjs",
    "audit:deps:all": "node scripts/audit-dependencies.mjs --all",
    "verify:lockfiles": "node scripts/verify-lockfile-integrity.mjs",
    "verify:lockfiles:fast": "node scripts/verify-lockfile-integrity.mjs --skip-signatures",
    "check": "biome check --write .",
    "check:deps": "npm run check:deps --prefix circlesfera-backend && npm run check:deps --prefix circlesfera-frontend",
    "backend:cov": "npm run test:cov --prefix circlesfera-backend",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "overrides": {
    "fast-uri": "4.1.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "husky": "9.1.7",
    "otplib": "13.5.0",
    "typescript": "6.0.3"
  }
}
